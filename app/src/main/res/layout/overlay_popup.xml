<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/popupGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_popup_glow" />

    <LinearLayout
        android:id="@+id/popupCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_popup_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tvPopupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:text="@string/popup_listening"
            android:textColor="@color/ghost_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="14dp">

            <View
                android:id="@+id/pulseRing1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pulse_ring" />

            <View
                android:id="@+id/pulseRing2"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pulse_ring" />

            <FrameLayout
                android:id="@+id/orb"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orb">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mic" />
            </FrameLayout>
        </FrameLayout>

        <com.ghost.ai.WaveformView
            android:id="@+id/waveform"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:hint="@string/popup_speak_now"
            android:minHeight="56dp"
            android:textColor="@color/ghost_text"
            android:textColorHint="@color/ghost_text_dim"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvPopupFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="@string/popup_tap_cancel"
            android:textColor="#5A5A75"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
