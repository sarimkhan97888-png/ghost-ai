<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="@color/ghost_purple"
                android:startColor="@color/ghost_cyan" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0B0B14" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
