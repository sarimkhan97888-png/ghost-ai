<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft outer glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2200F5D4" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <!-- gradient ring -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/ghost_purple"
                android:startColor="@color/ghost_cyan" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <!-- dark body -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ghost_bg" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
